# Copy this file to .env.
# Default workflow uses MQTT, so ADB is not required.
DEFLECTO_ADB_SERIAL=

DEFLECTO_ADB_PORT=8000
DEFLECTO_ADB_PATH=adb
DEFLECTO_ADB_REVERSE=0
DEFLECTO_SYNC_VIEWER=1
DEFLECTO_CONTROL_SET_URL=http://127.0.0.1:8000/api/set

# http = cach cu qua control_server.py + adb reverse/LAN
# mqtt = dong bo qua HiveMQ, khong can adb reverse cho viewer sync
DEFLECTO_CONTROL_MODE=mqtt

# HiveMQ Cloud MQTT TLS cho Python capture (*.hivemq.cloud, port 8883)
DEFLECTO_MQTT_HOST=
DEFLECTO_MQTT_PORT=8883
DEFLECTO_MQTT_USERNAME=
DEFLECTO_MQTT_PASSWORD=
DEFLECTO_MQTT_SESSION=lab1
DEFLECTO_MQTT_RETAIN=1

# Dat >0 neu muon Python cho du so dien thoai da render pattern moi.
DEFLECTO_MQTT_EXPECTED_VIEWERS=0
DEFLECTO_MQTT_ACK_TIMEOUT_SEC=2.0

# Neu muon PC ep chu ky soc cho viewer qua MQTT.
DEFLECTO_PATTERN_T=40
