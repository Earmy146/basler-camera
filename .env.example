# Copy this file to .env, then set the serial from:
# adb devices -l

# Leave blank if only one Android device/emulator is connected.
DEFLECTO_ADB_SERIAL=

DEFLECTO_ADB_PORT=8000
DEFLECTO_ADB_PATH=adb
DEFLECTO_ADB_REVERSE=1
DEFLECTO_SYNC_VIEWER=1
DEFLECTO_CONTROL_SET_URL=http://127.0.0.1:8000/api/set
